# The Procedure Machine — Streamlit Secrets template.
#
# Copy these names into your deployment's Secrets (Streamlit Cloud:
# app settings -> Secrets). Values shown are placeholders/defaults.
#
# OPENROUTER_API_KEY is the only secret value in this file. The
# three agent prompts — DRAFTING_SYSTEM_PROMPT, HFE_SYSTEM_PROMPT,
# COLD_READ_SYSTEM_PROMPT — also live in Secrets, but they are NOT
# distributed with this repository: they are the author's private
# instruction sets, kept out of the public tree on purpose. The app
# stops with a clear message if any of them is missing or out of
# date.

OPENROUTER_API_KEY = "sk-or-..."

# Model routing (OpenRouter model ids). Each name falls back to the
# default shown when unset. Relevance trimming rides MODEL_DRAFTING;
# HFE and cold read fall back to MODEL_DRAFTING when unset.
MODEL_DRAFTING = "openai/gpt-6-luna"
MODEL_HFE = "openai/gpt-6-luna"
MODEL_COLD_READ = "openai/gpt-6-luna"
MODEL_COMPACTION = "openai/gpt-6-luna"
MODEL_EXTRACTION = "google/gemini-2.5-flash"
MODEL_PACKET_CHECK = "google/gemini-2.5-flash"
MODEL_LOOKUP = "google/gemini-2.5-flash-lite"
